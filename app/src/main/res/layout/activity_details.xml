<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Full-bleed hero: clean artwork with the play / restart cluster
             as the only overlay. Title, rating, chips and watch actions live
             below on the page background. -->
        <FrameLayout
            android:id="@+id/heroArea"
            android:layout_width="match_parent"
            android:layout_height="340dp">

            <ImageView
                android:id="@+id/backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/scrim_hero_bottom" />

            <View
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_gravity="top"
                android:background="@drawable/scrim_top" />

            <!-- Top bar: back -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_dark"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_back"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <!-- Playback cluster: play sits at the exact centre (nudged down a
                 touch so it never covers the poster's centre), restart floats
                 offset to its right, resume label below -->
            <FrameLayout
                android:id="@+id/btnPlayHero"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:translationX="0dp"
                android:translationY="24dp"
                android:background="@drawable/bg_fab_red"
                android:elevation="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:translationX="-2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_play" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnPlayAgain"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:translationX="76dp"
                android:translationY="24dp"
                android:background="@drawable/bg_fab_red"
                android:elevation="8dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Restart from the beginning">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_replay" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtResume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:translationY="80dp"
                android:textColor="#CCE8353E"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Title, rating, chips and watch actions — pulled up over the
             poster's bottom scrim so the hero melts into the meta block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-84dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/star"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chipRuntime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chipGenres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="200dp"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Season/episode badge for series files ("S05 E03") -->
            <TextView
                android:id="@+id/txtEpisode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_chip_red"
                android:letterSpacing="0.12"
                android:paddingStart="12dp"
                android:paddingTop="3dp"
                android:paddingEnd="12dp"
                android:paddingBottom="3dp"
                android:textColor="#CCE8353E"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Note on huge files: streaming past 2 GB needs Premium -->
            <TextView
                android:id="@+id/txtBigFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:alpha="0.75"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- Story Line header with My List + download actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Story Line"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnAddList"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_circle_dark"
                    android:contentDescription="Add to My List"
                    android:src="@drawable/ic_heart"
                    app:tint="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/btnDownload"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_circle_dark"
                    android:contentDescription="Download"
                    android:src="@drawable/ic_download"
                    app:tint="@color/accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:maxLines="4"
                android:ellipsize="end"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtReadMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:padding="4dp"
                android:text="Read More"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- The Cast -->
            <TextView
                android:id="@+id/txtCastLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="The Cast"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/castRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone" />

            <!-- Other versions of the same title -->
            <TextView
                android:id="@+id/txtVersionsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Other versions"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/versionsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txtFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
